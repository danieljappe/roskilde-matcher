# Spotify OAuth credentials
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
# This must match exactly what you register in the Spotify Developer Dashboard
# For local dev: https://localhost:5173/callback
# For production: https://yourdomain.com/callback
SPOTIFY_REDIRECT_URI=https://localhost:5173/callback

# Session security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret

# Service URLs (defaults work for local Docker Compose)
FRONTEND_URL=https://localhost:5173
VITE_API_URL=http://localhost:8000

# Database (set automatically by Docker Compose)
# DATABASE_URL=postgresql+asyncpg://roskilde:roskilde@localhost:5432/roskilde
